# Flask Settings
FLASK_APP=app.py
FLASK_DEBUG=False
PORT=5000
HOST=0.0.0.0

# Database Settings
DB_PATH=football_data.db

# Background Tasks
ENABLE_BACKGROUND_TASKS=False

# API Keys (kendi key'lerinizi buraya yazin)
FOOTBALL_DATA_ORG_API_KEY=your_football_data_org_key_here
NGROK_AUTHTOKEN=your_ngrok_token_here
API_KEY=your_custom_api_key_here

# Bzzoiro Sports Data API
BSD_API_KEY=your_bsd_api_key_here
BSD_API_BASE=https://sports.bzzoiro.com

# PredixSport API
PREDIXSPORT_API_KEY=your_predixsport_key_here
PREDIXSPORT_API_BASE=https://api.predixsport.com/v1
