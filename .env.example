# Flask Settings
FLASK_APP=app.py
FLASK_DEBUG=False
PORT=5000
HOST=0.0.0.0

# Database Settings
# On Render, this should point to your persistent disk mount path, e.g., /opt/render/project/src/data/football_data.db
DB_PATH=football_data.db

# Background Tasks
# Set to True to enable AutoResearcher and Daily Updater (requires more RAM)
ENABLE_BACKGROUND_TASKS=False
